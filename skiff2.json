{
    "$schema": "https://storage.googleapis.com/skiff2-general/skiff2-config.schema.json",
    "services": [
        {
            "name": "genesys",
            "cwd": ".",
            "dockerFile": "Dockerfile",
            "isRootService": true,
            "allowUnauthenticated": true,
            "machine": {
                "cpu": "2",
                "memory": "8Gi",
                "minInstances": 1,
                "cpuIdle": false
            }
        }
    ]
}
